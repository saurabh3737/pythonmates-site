# Copy to .env.local for local testing (never commit .env.local).
# In production set these in Vercel → Project → Settings → Environment Variables.

# PythonMate AI tutor — key from Google AI Studio (aistudio.google.com/apikey).
# Use a separate Google Cloud project from saurabhjaiswal.com, with a budget alert.
GEMINI_API_KEY=

# Optional — main model (defaults to gemini-flash-lite-latest)
PYTHONMATE_MODEL=

# Optional — used when the main model is busy (defaults to gemini-flash-latest)
PYTHONMATE_FALLBACK_MODEL=
